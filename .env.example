# Copy this to .env before deploying
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING-AT-LEAST-32-CHARS

# Set to your Synology DDNS domain after setup
CORS_ORIGIN=https://cbre-yourdomain.synology.me

# AI invoice/contract extraction (Anthropic Claude)
ANTHROPIC_API_KEY=

# Email password-reset (Resend — https://resend.com). Leave RESEND_API_KEY blank to
# disable the email flow (admin reset in the app still works).
RESEND_API_KEY=
RESEND_FROM=CBRE Reporting <no-reply@mecflow.gr>
APP_BASE_URL=https://cbre.mecflow.gr
