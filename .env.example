# Copy this to .env before deploying
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING-AT-LEAST-32-CHARS

# Set to your Synology DDNS domain after setup
CORS_ORIGIN=https://cbre-yourdomain.synology.me

# AI invoice/contract extraction (Anthropic Claude)
ANTHROPIC_API_KEY=

# Email password-reset via SMTP (Zoho Mail). Leave SMTP_USER/SMTP_PASS blank to disable
# the email flow (admin reset in the app still works).
# Zoho region: smtp.zoho.eu (EU) or smtp.zoho.com (US). Port 465 = SSL.
# SMTP_PASS: use a Zoho "App Password" if 2FA is enabled on the mailbox.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=no-reply@mecflow.gr
SMTP_PASS=
SMTP_FROM=CBRE Reporting <no-reply@mecflow.gr>
APP_BASE_URL=https://cbre.mecflow.gr
